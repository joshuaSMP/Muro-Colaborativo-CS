<!DOCTYPE html>
<html>


  <head>
    <meta charset="UTF-8">
    <title>Card Sorting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css" integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/logIn/login.css" media="screen" type="text/css" />
    <link rel="stylesheet" href="/stylesheets/logIn/forms.css" media="screen" type="text/css" />
  </head>

  <style>
   .load-hover:hover{
        opacity: 0.8;
    }
  </style>

  <body class="bg-transparent">
    <div class="container float-right pr-0" style="position:relative; width: 30%; z-index: 9999;">
      <img src="/imagesv5/hexagono_azul2.svg" style="width: 24.3vw; height: 100%; float: right;">
      <img src="/imagesv5/boton_ingreso_rosa.svg" style="position: absolute; width: 25%; left: 29.5%; top: 15%;">
      <button id="adminZone" type="button" class="btn load-hover" style="background-color: #E68115; top: 25%;">Profesor</button>
      <button id="zonaPrivada" type="button" class="btn load-hover" style="background-color: #6DC8DD; top: 55%;">Alumno</button>
    </div>
    <div class="float-start ml-5 pl-5n pt-5">
      <img src="/imagesv5/logotipo_cs.png" class="mw-25" alt="MC_Logotipo" style="width: 30%;">
      <p class="lead ml-5 pl-5" style="font-size: 1vw; font-family: AvGardD; width: fit-content;">
        El Card Sorting es una de las técnicas mas importantes para la categorización <br>
        de contenidos, empleada en el diseño de experiencia de usuarios. Esta técnica <br>
        se practica con los mismos usuarios para descurbrir la forma como ellos organizan<br>
        sus contemidos, por medio de ejercicios, logra descurbrir el modo de organizar la <br>
        información que tienen asociada a un producto, servicio o marca.<br>
      </p>
    </div>

    <!--<footer class="text-center text-lg-start bg-transparent text-muted w-60 p-0 m-0" style="height: 115px;">-->
      <section class="d-flex justify-content-center justify-content-lg-between w-100 p-0 m-0">
        <div class="media text-center p-4 m-0 fixed-bottom" style="background-color: #003366; color:#ffffff; height: 15%;">
          <div class="media-body w-40" style="width: fit-content;">
            <p style="font-size: 0.8vw; margin-right: 2%; font-family: AvGardD; position: absolute; left: 15%;" >
                Hecho en México, Universidad Nacional Autónoma de México
                (UNAM), todos los derechos reservados 2023.<br>
            Realizado con el apoyo del Programa UNAM-DGAPA-PAPIME PE109823.<br>
            PE109623, PE214523, PE309523.<!-- &Uacute;ltima
            actualización: 31/05/2023</p>-->
            <div style=" position: absolute; left: 30%; bottom: 12%;">
              <a class="text-reset fw-bold" style="font-size: 0.7vw; font-family: AvGardD;" href="">Aviso de privacidad</a> | <a class="text-reset fw-bold" style="font-size: 0.7vw; font-family: AvGardD;" href="">Créditos</a>
            </div>
          </div>
            <img src="/imagesv5/logo_unam.svg" alt="Logo_UNAM" style="width: 4vw; right: 35%; position: absolute; bottom: 13%;">
            <img src="/imagesv5/logo_icat.svg" alt="Logo_ICAT" style="width: 3.5vw; position: absolute; right: 30%; bottom: 13%;">
            <img src="/imagesv5/logo_af.svg" alt="Logo_AF" style="width: 2.5vw; position: absolute; right: 25%; bottom: 13%;">
        </div>
      </section>

    <script src="javascripts/common/jquery211min.js"></script>
    <script src="javascripts/logIn/login.js"></script>
    <script>

      $("#zonaPrivada").click(function(){
        window.location = "/auth/user/";
      })
      $("#adminZone").click(function(){
        window.location = "/auth/admin/";
      })
    </script>
  </body>
</html>
