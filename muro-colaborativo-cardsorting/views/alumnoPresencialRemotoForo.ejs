        <div id="SubirFoto">
          <button class="close-button" onclick="closePanel('SubirFoto')" title="Cerrar">×</button>
          <div id="cargarfoto">
            <img src="/images/subir.png" width="30px" height="30px" style="margin: 6px; filter: invert(100%);" >
            <span class="textosubir">Subir Foto</span>
          </div>
          <input type="file" id="fileInput" style="display: none;" accept="image/*">
          <div id="tomarfoto">
            <img src="/images/foto.png" width="30px" style="margin: 7px; filter: invert(100%);"> <span class="textoforo">Tomar Foto</span>
          </div>
          <center>
            <div id="imagencargada">Sin imagen</div>
          </center>
          
          <button id="botonimagenAceptar" type="button" class="btn btn-light"
            onclick="enviarImagenAlServidor()">Aceptar</button>
        </div>
        <form id="uploadForm" action="/api/photo" method="post" enctype="multipart/form-data" style="display: none;">
          <input type="file" id="fileInput" name="file">
        </form>
        <div id="workspaceMode" class="content-wrapper" role="dialog">
          <div id="text-wrapper" action="/crearcontribucion" method="post" target="targetForm">
            <textarea id="texto" maxlength="250" placeholder="¡Escribe aquí!" onkeyup="count(this)"></textarea>
            <button class="close-button" onclick="closePanel('workspaceMode')" title="Cerrar">×</button>
            <span id="count" style="color: rgb(255, 255, 255);">250</span>
          </div>
                      <div id="OkCancelButtons">
              <button id="botonAceptarTexto" type="button" class="btn btn-light" data-dismiss="modal">Aceptar</button>
            </div>
          <!-- end object-cretion Area -->
        </div>
        <!-- End selectMosaicSpace -->
        <div id="linkMode" class="content-wrapper">
          <div id="link-text-wrapper">
            <p class="titulolink">Titulo:</p>
            <textarea id="nombreLinkArea" placeholder="Escriba nombre para el url"></textarea>
            <p class="titulourl">URL:</p>
            <textarea id="linkArea" placeholder="Escriba url"></textarea>
            <button class="close-button" onclick="closePanel('linkMode')" title="Cerrar">×</button>
          </div>
                      <div id="botonesLink">
              <button id="okLink" type="button" class="btn btn-light">Aceptar</button>
            </div>
        </div>

