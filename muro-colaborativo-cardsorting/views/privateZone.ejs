    <script>
      // code for detect mobile devices!! pretty awesome
      if (jQuery.browser.mobile) {
        var portrait;
        $('head').append('<meta name="viewport" content="width=device-width, initial-scale=0.35, minimum-scale=0.15, maximum-scale=0.35, user-scalable=yes" >');  // Meta tag for mobile devices
        $(document).ready(function () {
          $("#mosaicsCreatedWrapper").css("height", "40vh")
        })
         // verify whether is in portrait or landscape
        portrait = window.innerHeight > window.innerWidth;
        $(window).resize(function () { // Start code to attend resize
          portrait = window.innerHeight > window.innerWidth
          if (portrait) { // verify whether is in portrait or landscape
            if (model.mode == "workspace") {
              $("#sidebar-wrapper").css("height", "100%");
              $("#sidebar-wrapper").css("width", "347px");
              $("#colorSelectedSquare").css("margin-top", "-35px");
              $("#colorSelectedSquare").css("margin-left", "60px");
              $("#sidebar-wrapper").css("height", "347px");
              $("#sidebar-wrapper").css("width", "100%");
              $("#workspaceMode").css("margin-top", "220px");
              $("#workspaceMode").css("margin-left", "0px");
            }
          } else {
            if (model.mode == "workspace") {
              $("#sidebar-wrapper").css("height", "347px");
              $("#sidebar-wrapper").css("width", "100%");
              $("#colorSelectedSquare").css("margin-top", "0px");
              $("#colorSelectedSquare").css("margin-left", "10px");
              $("#sidebar-wrapper").css("height", "100%");
              $("#sidebar-wrapper").css("width", "347px");
              $("#workspaceMode").css("margin-top", "0px");
              $("#workspaceMode").css("margin-left", "220px");
            }
          }
        });// End code to attend resize
      }// End code for mobile devices
      //Function for character counter
      function count(val) {
        var len = val.value.length;
        if (len >= 251) {
              val.value = val.value.substring(0, 250);
        } else {
              $('#count').text(250 - len);
        }
            }
      
      // Función para cerrar el panel de opciones
      function closePanel(panelId) {
        document.getElementById(panelId).style.display = 'none';
      }
    </script>
