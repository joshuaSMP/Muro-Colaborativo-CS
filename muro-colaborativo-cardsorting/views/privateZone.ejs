      .fifty-px-height {
        height:50px;
      }
      .static-pos {
        position:static;
      }
      .invisible-dom {
        visibility: hidden;
      }
      .four-x-font {
        font-size: 400%;
      }
      .pause-banner {
        height:270px;
        width:270px;
        margin: 0 auto;
        border-radius: 25px;
        border: 2px solid white;
        background-image: url('/images/black_pause_btn.png');
        background-size: 100%;
      }
      .back-to-button-arrow {
        width:100px;
        height:100px;
        margin-left:60px;
        margin-bottom:55px;
        float:left;
      }
      #userDisplay {
        color:white;
        font-size:200%;
        margin-left:30px;
        display:none;
      }

      #deleteObject {
        width:100px;
        height:100px;
        margin-left:63px;
        margin-top:28px;
      }
      #submitUpload {
        visibility:hidden
      }
      #page-content-wrapper {
        height:100%;
        width:100%;
        background: #F2F2F2;;
        position:relative;
        top:0px;
        left:0px;
        overflow-x: hidden;
        overflow-y: auto;
        z-index:0;
      }
      #trackpadMode {
        position:absolute;
      }
      #dummyTrackpadMode {
        height:100%;
        width:100%;
      }
      #moveButton {
        text-align: center;
        border-radius: 25px;
        border: 4px solid #9b59b6;
        height:120px;
      }
      #editButton {
        text-align: center;
        border-radius: 25px;
        border: 4px solid #FFFFFF;
        height:120px;
      }
      #selectObjectBtn {
        text-align: center;
        border-radius: 25px;
        border: 4px solid #2980b9;
        height:120px;
      }
      #editObjectBtn {
        text-align: center;
        border-radius: 25px;
        border: 4px solid #2ecc71;
        height:120px;
      }
      #deleteObjectBtn {
        text-align: center;
        border-radius: 25px;
        border: 4px solid #c0392b;
        height:120px;
      }
    </style>
    <script>
      if (localStorage.getItem("userId") == null) {
      	window.location = "/auth/user/";
      }
    </script>
