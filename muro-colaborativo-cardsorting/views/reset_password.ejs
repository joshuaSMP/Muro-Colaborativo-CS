<!DOCTYPE html>
<html lang="en-EN">
  <head>
    <title>Recuperaci&oacute;n de contrase&ntilde;a</title>
    <link href="/stylesheets/common/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="/stylesheets/common/sweetalert.css">
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/style.css">
    <link rel="stylesheet" type="text/css" href="/stylesheets/login_admin/login_admin.css">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.7, minimum-scale=0.5, maximum-scale=0.7, user-scalable=yes" />
    <script>
      if (localStorage.getItem("logged") == "true") {
      	window.location = "/admin/"
      }
      if(<%= requestId && requestId.length ? requestId.length : 0 %> != 64) {
        window.location = "/"
      }
    </script>
    <style>
      body {
        background-color:white
      }
      .header-container {
        background-color:#142d59;
      }
      .adef-logo-container {
        height:80px;
        width:165px;
        margin-left:10px;
        margin-top:20px
      }
      .white-color {
        color:white
      }
    </style>
  </head>
  <body>
    <div class="container-fluid">
      <div class="row header-container">
        <div class="col-xs-2">
          <img class='adef-logo-container' src='/images/logoADF_whire.png' />
        </div>
        <div class="col-xs-5"></div>
        <div class="col-xs-5">
          <h2 class="white-color">Recuperaci&oacute;n de cuenta</h2>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-4"></div>
        <div class="col-sm-4">
          <div class="login-page">
            <div class="form">
              <input id="newPassword" type="password"
                placeholder="Nueva Contrase&ntilde;a" />
              <button id="reset-pass-btn">Cambiar contrase&ntilde;a</button>
            </div>
          </div>
        </div>
        <div class="col-sm-4"></div>
      </div>
    </div>
    <script src="/javascripts/common/jquery211min.js"></script>
    <script src="/javascripts/common/bootstrap.min.js"></script>
    <script src="/javascripts/common/jquery-ui.js"></script>
    <script src="/javascripts/common/sweetalert.min.js"></script>
    <script >
      function gotoLogin() {
        window.location = "/auth/admin/"
      }
      $("#reset-pass-btn").click(function() {
        var data = {
          password : $("#newPassword").val(),
      		request_id : '<%= requestId %>'
      	}
        $.ajax({
      		method: "POST",
      		url : "/api/users/reset/",
      		data : data,
      		dataType : "JSON",
      		success: function(res) {
      			swal({
              title : "Contraseña actualizada",
              text : "Se ha cambiado su contraseña",
              type : "success",
              confirmButtonColor: "#DD6B55",
              confirmButtonText: "Acceder...",
              closeOnConfirm: false
            }, gotoLogin)
      		},
      		error: function(err) {
      			swal({
              title : "Solicitud expirada",
              text : "La solicitud de recuperación de contraseña ha expirado",
              type : "error",
              confirmButtonColor: "#d9534f",
              confirmButtonText: "Volver",
              closeOnConfirm: false
            }, gotoLogin)
      		}
      	})
      })
    </script>
  </body>
</html>