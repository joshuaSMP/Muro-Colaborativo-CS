    owners text[],
    public_id text,
    image_path text,
    last_edited_date timestamp with time zone DEFAULT timezone('America/Mexico_City'::text, now()),
    edited_times integer DEFAULT 0,
    is_deleted boolean DEFAULT false NOT NULL
);


