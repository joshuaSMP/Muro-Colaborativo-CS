--
-- Name: activity; Type: TABLE; Schema: public; Owner: adef
--

CREATE TABLE public.activity (
    id uuid DEFAULT public.uuid_generate_v1() NOT NULL,
    pin integer NOT NULL,
    background_image text,
    owner_id uuid,
    is_deleted boolean DEFAULT false NOT NULL,
    edited_date timestamp with time zone DEFAULT timezone('America/Mexico_City'::text, now()),
    creation_date timestamp with time zone DEFAULT timezone('America/Mexico_City'::text, now()),
    name character varying(100),
    is_paused boolean DEFAULT false,
    activation_date timestamp with time zone DEFAULT timezone('America/Mexico_City'::text, now()),
    is_active boolean DEFAULT true NOT NULL,
    max_number_users smallint DEFAULT 20
);


ALTER TABLE public.activity OWNER TO adef;

--
-- Name: activity_user; Type: TABLE; Schema: public; Owner: adef
--

CREATE TABLE public.activity_user (
    pin integer NOT NULL,
    username text NOT NULL,
    cursor integer,
    last_login timestamp with time zone,
    last_logout timestamp with time zone
);


ALTER TABLE public.activity_user OWNER TO adef;

--
-- Name: shared_object; Type: TABLE; Schema: public; Owner: adef
--

CREATE TABLE public.shared_object (
    id uuid DEFAULT public.uuid_generate_v1() NOT NULL,
    room integer,
    percentage_x numeric NOT NULL,
    percentage_y numeric NOT NULL,
    type character varying(50) NOT NULL,
    cursor integer,
    text text,
    creation_date timestamp with time zone DEFAULT now() NOT NULL,
    owners text[],
    public_id character(16) NOT NULL,
    image_path text,
    last_edited_date timestamp with time zone DEFAULT timezone('America/Mexico_City'::text, now()),
    edited_times integer DEFAULT 0,
    activity_id uuid,
    is_deleted boolean DEFAULT false NOT NULL
);


ALTER TABLE public.shared_object OWNER TO adef;

--
-- Name: user; Type: TABLE; Schema: public; Owner: adef
--

CREATE TABLE public."user" (
    id uuid DEFAULT public.uuid_generate_v1() NOT NULL,
    name text,
    email text NOT NULL,
    pw character varying(100),
    last_pw_reset timestamp with time zone,
    pw_reset_request_id character(64),
    last_updated timestamp with time zone DEFAULT timezone('America/Mexico_City'::text, now()),
    is_deleted boolean DEFAULT false NOT NULL
);


ALTER TABLE public."user" OWNER TO adef;

