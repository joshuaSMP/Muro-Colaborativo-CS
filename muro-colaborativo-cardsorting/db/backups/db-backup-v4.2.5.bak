--
-- Name: activity activity_pin_key; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.activity
    ADD CONSTRAINT activity_pin_key UNIQUE (pin);


--
-- Name: activity activity_pkey; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.activity
    ADD CONSTRAINT activity_pkey PRIMARY KEY (id);


--
-- Name: activity_user activity_user_pkey; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.activity_user
    ADD CONSTRAINT activity_user_pkey PRIMARY KEY (pin, username);


--
-- Name: shared_object shared_object_pkey; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.shared_object
    ADD CONSTRAINT shared_object_pkey PRIMARY KEY (id);


--
-- Name: shared_object shared_object_room_cursor_image_path_key; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.shared_object
    ADD CONSTRAINT shared_object_room_cursor_image_path_key UNIQUE (room, cursor, image_path);


--
-- Name: shared_object shared_object_room_cursor_text_key; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.shared_object
    ADD CONSTRAINT shared_object_room_cursor_text_key UNIQUE (room, cursor, text);


--
-- Name: shared_object shared_object_room_public_id_key; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.shared_object
    ADD CONSTRAINT shared_object_room_public_id_key UNIQUE (room, public_id);


--
-- Name: user user_email_key; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public."user"
    ADD CONSTRAINT user_email_key UNIQUE (email);


--
-- Name: user user_pkey; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public."user"
    ADD CONSTRAINT user_pkey PRIMARY KEY (id);


--
-- Name: user user_pw_reset_request_id_key; Type: CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public."user"
    ADD CONSTRAINT user_pw_reset_request_id_key UNIQUE (pw_reset_request_id);


--
-- Name: activity activity_time_updater; Type: TRIGGER; Schema: public; Owner: adef
--

CREATE TRIGGER activity_time_updater AFTER UPDATE ON public.activity FOR EACH ROW EXECUTE PROCEDURE public.update_activity_times();


--
-- Name: shared_object generate_shared_object_public_id; Type: TRIGGER; Schema: public; Owner: adef
--

CREATE TRIGGER generate_shared_object_public_id BEFORE INSERT ON public.shared_object FOR EACH ROW EXECUTE PROCEDURE public.issue_shared_object_public_id();


--
-- Name: activity_user seat_assigner; Type: TRIGGER; Schema: public; Owner: adef
--

CREATE TRIGGER seat_assigner BEFORE INSERT OR UPDATE ON public.activity_user FOR EACH ROW EXECUTE PROCEDURE public.assign_seat();


--
-- Name: shared_object shared_object_edited_time_updater; Type: TRIGGER; Schema: public; Owner: adef
--

CREATE TRIGGER shared_object_edited_time_updater AFTER UPDATE ON public.shared_object FOR EACH ROW EXECUTE PROCEDURE public.update_shared_object_times();


--
-- Name: user user_update_validator; Type: TRIGGER; Schema: public; Owner: adef
--

CREATE TRIGGER user_update_validator BEFORE UPDATE ON public."user" FOR EACH ROW EXECUTE PROCEDURE public.validate_password_change();


--
-- Name: activity activity_owner_id_fkey; Type: FK CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.activity
    ADD CONSTRAINT activity_owner_id_fkey FOREIGN KEY (owner_id) REFERENCES public."user"(id);


--
-- Name: activity_user activity_user_pin_fkey; Type: FK CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.activity_user
    ADD CONSTRAINT activity_user_pin_fkey FOREIGN KEY (pin) REFERENCES public.activity(pin) ON DELETE CASCADE;


--
-- Name: shared_object shared_object_activity_id_fkey; Type: FK CONSTRAINT; Schema: public; Owner: adef
--

ALTER TABLE ONLY public.shared_object
    ADD CONSTRAINT shared_object_activity_id_fkey FOREIGN KEY (activity_id) REFERENCES public.activity(id);


